* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: Tahoma, Arial, sans-serif;
  line-height: 1.9;
  color: #222;
  background: #f5f6f8;
}

header {
  background: #1e3a5f;
  color: #fff;
  padding: 20px;
  text-align: center;
}

header h1 { font-size: 1.8rem; margin-bottom: 10px; }

nav a {
  color: #fff;
  text-decoration: none;
  margin: 0 10px;
  font-size: 1rem;
}

nav a:hover { text-decoration: underline; }

main {
  max-width: 800px;
  margin: 25px auto;
  padding: 0 15px;
}

main h2 { margin-bottom: 15px; color: #1e3a5f; }

article {
  background: #fff;
  padding: 18px;
  margin-bottom: 15px;
  border-radius: 8px;
  box-shadow: 0 1px 4px rgba(0,0,0,0.1);
}

article h3 a { color: #1e3a5f; text-decoration: none; }
article p { margin-top: 8px; color: #555; }

.post { background: #fff; padding: 20px; border-radius: 8px; }
.post h1 { color: #1e3a5f; margin-bottom: 15px; }
.post h2 { margin: 20px 0 10px; color: #1e3a5f; }
.post p { margin-bottom: 12px; }

footer {
  background: #1e3a5f;
  color: #fff;
  text-align: center;
  padding: 18px;
  margin-top: 30px;
}

footer a { color: #fff; margin: 0 5px; }